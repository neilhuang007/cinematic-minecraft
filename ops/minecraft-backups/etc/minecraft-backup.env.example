# Copy to /etc/minecraft-backup.env on the server and restrict it to root.
# Keep real Borg and RCON credentials only in that server-local file.
BORG_REPO=/srv/minecraft/backups/borg
SRV_DIR=/srv/minecraft/servers/fabric-1.21.11
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=replace-me

# Daily archives: 14 days. Keep every login/logout archive for 2 days, then
# one event archive per day for 7 days. A zero debounce creates a snapshot for
# every genuine login and logout. Set a positive number only if reconnect
# churn becomes a problem; login and logout never suppress one another.
KEEP_DAILY=14
KEEP_EVENT_WITHIN=2d
KEEP_EVENT_DAILY=7
EVENT_DEBOUNCE_SECONDS=0
SAVE_FLUSH_WAIT_SECONDS=3
